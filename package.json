{
  "name": "circle-agent-team",
  "version": "1.0.0",
  "description": "Circle — 单 Agent 多任务协作系统（Coordinator / Worker / Scheduler Agent Team）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx test/run.ts",
    "test:unit": "tsx test/unit.test.ts",
    "test:case1": "tsx test/case1-long-task.test.ts",
    "test:case2": "tsx test/case2-scheduled-task.test.ts",
    "test:case3": "tsx test/case3-safety-intercept.test.ts",
    "test:case4": "tsx test/case4-restart-reconcile.test.ts",
    "report": "tsx test/run.ts --report-only"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "wechaty": "^1.20.2"
  }
}
